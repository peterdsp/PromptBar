    "API keys are stored in the macOS Keychain. They never leave your Mac except when sent to the URL above.": {
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κλειδιά API αποθηκεύονται στο Keychain του macOS. Δεν φεύγουν ποτέ από το Mac σας, παρά μόνο όταν αποστέλλονται στο παραπάνω URL."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés API sont stockées dans le Trousseau macOS. Elles ne quittent jamais votre Mac, sauf lorsqu'elles sont envoyées à l'URL ci-dessus."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Çelësat API ruhen në Keychain të macOS. Nuk largohen kurrë nga Mac-u yt, përveçse kur dërgohen te URL-ja më sipër."
          }
        }
      }
    },
