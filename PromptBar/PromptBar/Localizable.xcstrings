    "Add a chat-completions endpoint to chat natively from your menubar.": {
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ένα endpoint chat-completions για να συνομιλείτε απευθείας από τη γραμμή μενού."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un point d'API chat-completions pour chatter nativement depuis votre barre de menus."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shto një endpoint chat-completions për të biseduar drejtpërdrejt nga shiriti i menusë."
          }
        }
      }
    },
    "Add a prompt, it'll be one tap away in every chat.": {
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ένα prompt και θα το έχετε με ένα πάτημα σε κάθε συνομιλία."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un prompt, il sera à portée de clic dans chaque chat."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shto një prompt dhe do ta kesh një prekje larg në çdo bisedë."
          }
        }
      }
    },
    "Add an HTTP MCP server endpoint to extend your chats with real tools.": {
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε ένα endpoint διακομιστή HTTP MCP για να επεκτείνετε τις συνομιλίες σας με πραγματικά εργαλεία."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez l'adresse d'un serveur MCP HTTP pour étendre vos chats avec de vrais outils."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Shto një endpoint serveri HTTP MCP për t'i zgjeruar bisedat me mjete të vërteta."
          }
        }
      }
    },
    "Add prompts from Settings → Prompts.": {
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε prompts από τις Ρυθμίσεις → Prompts."
          }
        },
        "fr": {
          "stringUnit": {
