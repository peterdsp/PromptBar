# Copy this file to /home/pi/promptbar/.env on your Raspberry Pi, fill in
# real values, then chmod 600 it. systemd EnvironmentFile reads it.

# Ko-fi verification token. Get it from Ko-fi dashboard:
#   More -> API -> Verification Token. Same token shows up in every webhook
#   payload; we reject any POST whose token doesn't match.
KOFI_VERIFICATION_TOKEN=replace-me

# Absolute path to the Ed25519 private key (raw 32 bytes, base64).
# Copy it from your Mac (scripts/license-private.key) once.
PROMPTBAR_PRIVATE_KEY=/home/pi/promptbar/license-private.key

# Minimum version a license unlocks. Bump this when shipping 3.0 if you
# want fresh licenses for the new major.
PROMPTBAR_MIN_VERSION=2.0.0

# Where the server archives every license it issues (one file per buyer).
PROMPTBAR_LOG_DIR=/home/pi/promptbar/issued

# Which Ko-fi shop items count as PromptBar. Easiest: get the
# direct_link_code from a real Ko-fi webhook log. Comma separated. If
# blank, the server falls back to matching 'promptbar' in the item name.
PROMPTBAR_LINK_CODES=b1ef047a6f

# Lowercase substring matched against shop_items[].variation_name and
# the message field if the link-code allow list is empty.
PROMPTBAR_NAME_MATCH=promptbar

# SMTP delivery for the license file. Gmail works with an app-specific
# password (https://myaccount.google.com/apppasswords). Other providers:
#   smtp.fastmail.com:465 (SSL)
#   smtp.resend.com:587 (TLS)
#   smtp.sendgrid.net:587 (TLS, user: 'apikey')
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=peterdsp29@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=peterdsp29@gmail.com
SMTP_FROM_NAME=Petros Dhespollari

# Optional: bind port. Cloudflare Tunnel will forward 443 -> this port.
PORT=8000
