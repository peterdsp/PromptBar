    "Pick the closest one. We'll set up the right defaults." : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Διάλεξε αυτό που ταιριάζει πιο πολύ. Θα στήσουμε τις σωστές προεπιλογές." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Choisissez le plus proche. On configurera les bons réglages." } },
        "sq" : { "stringUnit" : { "state" : "translated", "value" : "Zgjidh atë më të afërt. Do t'i caktojmë vlerat e duhura." } }
