    "Acts like Safari or Claude, with a Dock icon and a real window.": {
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λειτουργεί όπως το Safari ή το Claude, με εικονίδιο στο Dock και κανονικό παράθυρο."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se comporte comme Safari ou Claude, avec une icône dans le Dock et une vraie fenêtre."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Sillet si Safari ose Claude, me një ikonë në Dock dhe një dritare të vërtetë."
          }
        }
      }
    },
