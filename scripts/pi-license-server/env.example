# Copy this file to /home/pi/promptbar/.env on your Raspberry Pi, fill in
# real values, then chmod 600 it. systemd EnvironmentFile reads it.

# Ko-fi verification token. Get it from Ko-fi dashboard:
#   More -> API -> Verification Token. Same token shows up in every webhook
#   payload; we reject any POST whose token doesn't match.
KOFI_VERIFICATION_TOKEN=replace-me

# Absolute path to the Ed25519 private key (raw 32 bytes, base64).
# Copy it from your Mac (scripts/license-private.key) once.
PROMPTBAR_PRIVATE_KEY=/home/pi/promptbar/license-private.key

# Minimum version a license unlocks. Bump this when shipping 3.0 if you
# want fresh licenses for the new major.
PROMPTBAR_MIN_VERSION=2.0.0

# Where the server archives every license it issues (one file per buyer).
PROMPTBAR_LOG_DIR=/home/pi/promptbar/issued

# Which Ko-fi shop items count as PromptBar. Easiest: get the
# direct_link_code from a real Ko-fi webhook log. Comma separated. If
# blank, the server falls back to matching 'promptbar' in the item name.
PROMPTBAR_LINK_CODES=b1ef047a6f

# Lowercase substring matched against shop_items[].variation_name and
# the message field if the link-code allow list is empty.
PROMPTBAR_NAME_MATCH=promptbar

# Operator emails that get an auto-archived license at server startup
# (so you can always /activate from any Mac) and receive BCC on every
# license email (so your inbox is a permanent record). Comma separated.
ADMIN_EMAILS=info@peterdsp.dev
# Defaults to ADMIN_EMAILS if blank. Override here if you want BCC
# routing different from the auto-archived set.
BCC_LICENSE_EMAILS=info@peterdsp.dev

# SMTP delivery for the license file. Gmail works with an app-specific
# password (https://myaccount.google.com/apppasswords). Other providers:
#   smtp.fastmail.com:465 (SSL)
#   smtp.resend.com:587 (TLS)
#   smtp.sendgrid.net:587 (TLS, user: 'apikey')
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=peterdsp29@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=peterdsp29@gmail.com
SMTP_FROM_NAME=Petros Dhespollari

# Optional: bind port. Cloudflare Tunnel will forward 443 -> this port.
PORT=8000

# /activate throttle, per client IP. The order-id check is the real
# control; this just slows down anyone grinding order ids against a known
# address. gunicorn runs 2 workers and the counter is per-process, so the
# real ceiling is roughly double ACTIVATE_RATE_MAX per window.
ACTIVATE_RATE_MAX=10
ACTIVATE_RATE_WINDOW=300

# ---------------------------------------------------------------------------
# Additional products (one Ko-fi account = one webhook, so this server is
# multi-product). A product is only registered when its *_PRIVATE_KEY is
# set, so leaving these blank simply ignores that product's orders.

# ---- klipa (https://klipa.peterdsp.dev) ----
# Ed25519 signing key for klipa licenses (raw 32 bytes, base64), separate
# from the PromptBar key so a license for one can't unlock the other.
KLIPA_PRIVATE_KEY=/home/peterdsp/promptbar/klipa-license-private.key
KLIPA_MIN_VERSION=0.4.0
# klipa's Ko-fi direct_link_code (from a real webhook log); name match is
# the fallback if the code list doesn't hit.
KLIPA_LINK_CODES=4e1cf2ac40
KLIPA_NAME_MATCH=klipa

# ---------------------------------------------------------------------------
# gunicorn's control server opens a socket under $HOME/.gunicorn. Under
# systemd ProtectHome=read-only that path is read-only and wedges the
# workers, so point HOME at the (writable, ReadWritePaths) app dir.
HOME=/home/peterdsp/promptbar
