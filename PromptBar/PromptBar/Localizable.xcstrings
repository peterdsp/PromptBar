    "Bring your own API key. PromptBar speaks the standard chat-completions schema, so any endpoint that supports it works.": {
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φέρτε το δικό σας κλειδί API. Το PromptBar μιλά το πρότυπο σχήμα chat-completions, οπότε λειτουργεί κάθε endpoint που το υποστηρίζει."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apportez votre propre clé API. PromptBar parle le schéma standard chat-completions, donc tout point d'API qui le prend en charge fonctionne."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill çelësin tënd API. PromptBar flet skemën standarde chat-completions, prandaj funksionon çdo endpoint që e mbështet."
          }
        }
      }
    },
