    "Window mode: PromptBar acts like a regular app with a Dock icon and a window. The menubar icon stays as a quick toggle.": {
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λειτουργία παραθύρου: το PromptBar συμπεριφέρεται σαν κανονική εφαρμογή, με εικονίδιο στο Dock και παράθυρο. Το εικονίδιο της γραμμής μενού παραμένει ως γρήγορος διακόπτης."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode fenêtre : PromptBar se comporte comme une app classique, avec une icône dans le Dock et une fenêtre. L'icône de la barre de menus reste un accès rapide."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Modaliteti i dritares: PromptBar sillet si një aplikacion i zakonshëm, me ikonë në Dock dhe një dritare. Ikona e shiritit të menusë mbetet si çelës i shpejtë."
          }
        }
      }
    },
    "Wire it to your real tools": {
      "extractionState": "stale",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Σύνδεσέ το με τα πραγματικά σου εργαλεία"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchez-le à vos vrais outils"
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Lidhe me veglat e tua të vërteta"
          }
        }
      }
    },
    "Wrap any web chat URL in your menubar.": {
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενσωματώστε οποιοδήποτε URL διαδικτυακής συνομιλίας στη γραμμή μενού σας."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encapsulez n'importe quelle URL de chat web dans votre barre de menus."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mbështill çdo URL bisede web në shiritin e menusë."
          }
        }
      }
    },
    "Wrap any web chat in your menubar, or bring your own API key for a native streaming chat. Both are private, both are yours.": {
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τύλιξε οποιοδήποτε web chat στη menubar σου ή φέρε το δικό σου κλειδί API για native streaming chat. Και τα δύο είναι ιδιωτικά, και τα δύο είναι δικά σου."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encapsulez n'importe quel chat web dans votre barre de menus, ou apportez votre clé API pour un chat natif en streaming. Les deux sont privés, les deux sont à vous."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mbështill çdo bisedë web në menubar, ose sill çelësin tënd të API për një bisedë vendase me streaming. Të dyja janë private, të dyja janë të tuat."
          }
        }
      }
    },
    "Wrap any web-based chat URL. You name it; PromptBar wraps it.": {
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενσωματώστε οποιοδήποτε URL διαδικτυακής συνομιλίας. Εσείς του δίνετε όνομα, το PromptBar το τυλίγει."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encapsulez n'importe quelle URL de chat web. Vous la nommez ; PromptBar l'encapsule."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Mbështill çdo URL bisede në web. Ti e emërton; PromptBar e mbështjell."
          }
        }
      }
    },
