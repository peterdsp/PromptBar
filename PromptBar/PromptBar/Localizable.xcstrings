    "Bring PromptBar forward from any app, even full screen.": {
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εμφανίστε το PromptBar από οποιαδήποτε εφαρμογή, ακόμη και σε πλήρη οθόνη."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez PromptBar depuis n'importe quelle app, même en plein écran."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Sill PromptBar-in përpara nga çdo aplikacion, edhe në ekran të plotë."
          }
        }
      }
    },
    "Bring your own API key": {
      "extractionState": "stale",
      "localizations": {
