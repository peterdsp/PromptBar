    },
    "If your server uses a bearer token, paste it as 'Authorization: Bearer <token>'. Custom header keys also work, e.g. 'X-API-Key: <token>'.": {
      "extractionState": "manual",
      "localizations": {
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αν ο διακομιστής σας χρησιμοποιεί bearer token, επικολλήστε το ως 'Authorization: Bearer <token>'. Λειτουργούν και προσαρμοσμένα κλειδιά κεφαλίδας, π.χ. 'X-API-Key: <token>'."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si votre serveur utilise un jeton bearer, collez-le sous la forme « Authorization: Bearer <token> ». Les clés d'en-tête personnalisées fonctionnent aussi, par ex. « X-API-Key: <token> »."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Nëse serveri yt përdor një bearer token, ngjite si 'Authorization: Bearer <token>'. Funksionojnë edhe çelësa header të personalizuar, p.sh. 'X-API-Key: <token>'."
          }
        }
      }
    },
