{
  "sourceLanguage" : "en",
  "version" : "1.0",
  "strings" : {
    "Welcome to PromptBar" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Καλώς ήρθες στο PromptBar" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Bienvenue dans PromptBar" } },
        "sq" : { "stringUnit" : { "state" : "translated", "value" : "Mirë se vjen në PromptBar" } }
      }
    },
    "Your AI workbench, one keystroke away." : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ο πάγκος εργασίας σου για AI, ένα πλήκτρο μακριά." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Votre atelier IA, à une touche." } },
        "sq" : { "stringUnit" : { "state" : "translated", "value" : "Tavolina jote e AI, vetëm një tast larg." } }
      }
    },
    "Press ⌥⌘O from anywhere to summon PromptBar" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Πάτα ⌥⌘O από οπουδήποτε για να καλέσεις το PromptBar" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Appuyez sur ⌥⌘O n'importe où pour invoquer PromptBar" } },
        "sq" : { "stringUnit" : { "state" : "translated", "value" : "Shtyp ⌥⌘O nga kudo për të thirrur PromptBar" } }
      }
    },
    "Yours to shape" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Δικό σου να το διαμορφώσεις" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "À vous de le façonner" } },
        "sq" : { "stringUnit" : { "state" : "translated", "value" : "Yti për ta formuar" } }
      }
    },
    "Ships empty. No bundled providers, no third-party logos. You add the URLs and the keys you actually use." : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Έρχεται άδειο. Χωρίς προεπιλεγμένους παρόχους, χωρίς λογότυπα τρίτων. Προσθέτεις τα URL και τα κλειδιά που πραγματικά χρησιμοποιείς." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Livré vide. Aucun fournisseur intégré, aucun logo tiers. Vous ajoutez les URL et les clés que vous utilisez vraiment." } },
        "sq" : { "stringUnit" : { "state" : "translated", "value" : "Vjen bosh. Pa ofrues të paracaktuar, pa logo të palëve të treta. Ti shton URL-të dhe çelësat që përdor vërtet." } }
      }
    },
    "Bring your own API key" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Φέρε το δικό σου κλειδί API" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Apportez votre propre clé API" } },
        "sq" : { "stringUnit" : { "state" : "translated", "value" : "Sill çelësin tënd të API" } }
      }
    },
    "Native streaming chat against any chat-completions endpoint. Keys live in the macOS Keychain, never UserDefaults, never iCloud." : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Εγγενής συνομιλία streaming σε οποιοδήποτε endpoint chat-completions. Τα κλειδιά μένουν στο Keychain του macOS, ποτέ στο UserDefaults, ποτέ στο iCloud." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Chat natif en streaming contre n'importe quel point d'API chat-completions. Les clés vivent dans le Trousseau macOS, jamais dans UserDefaults, jamais iCloud." } },
        "sq" : { "stringUnit" : { "state" : "translated", "value" : "Bisedë vendase me streaming kundër çdo pikë-fundi chat-completions. Çelësat rrojnë në Keychain-in e macOS, kurrë në UserDefaults, kurrë në iCloud." } }
      }
    },
    "Wire it to your real tools" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Σύνδεσέ το με τα πραγματικά σου εργαλεία" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Branchez-le à vos vrais outils" } },
        "sq" : { "stringUnit" : { "state" : "translated", "value" : "Lidhe me veglat e tua të vërteta" } }
      }
    },
    "Connect MCP servers. Your AI can read and act on your real workspace, design tools, issue trackers, source control, your dashboards." : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Σύνδεσε servers MCP. Το AI σου μπορεί να διαβάσει και να ενεργήσει στον πραγματικό σου χώρο εργασίας, εργαλεία σχεδιασμού, issue trackers, source control, dashboards." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Connectez des serveurs MCP. Votre IA peut lire et agir sur votre vrai espace de travail, outils de design, suivi de tickets, source control, vos dashboards." } },
        "sq" : { "stringUnit" : { "state" : "translated", "value" : "Lidh serverët MCP. AI yt mund të lexojë dhe veprojë në hapësirën tënde reale të punës, mjete dizajni, ndjekës biletash, kontroll burimi, dashboard-et e tua." } }
      }
    },
    "Private by design" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Ιδιωτικό από σχεδίαση" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Privé par conception" } },
        "sq" : { "stringUnit" : { "state" : "translated", "value" : "Privat nga vetë dizajni" } }
      }
    },
    "No analytics, no telemetry, no remote config. Updates check GitHub Releases directly." : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Χωρίς analytics, χωρίς telemetry, χωρίς remote config. Οι ενημερώσεις ελέγχουν απευθείας τα GitHub Releases." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucune analytique, aucune télémétrie, aucune configuration distante. Les mises à jour vérifient directement les GitHub Releases." } },
        "sq" : { "stringUnit" : { "state" : "translated", "value" : "Pa analitikë, pa telemetri, pa konfigurim të largët. Përditësimet kontrollojnë drejtpërsëdrejti GitHub Releases." } }
      }
    },
    "Companion project: Kujto" : {
      "localizations" : {
        "el" : { "stringUnit" : { "state" : "translated", "value" : "Συνοδευτικό project: Kujto" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Projet compagnon : Kujto" } },
        "sq" : { "stringUnit" : { "state" : "translated", "value" : "Projekt shoqërues: Kujto" } }
