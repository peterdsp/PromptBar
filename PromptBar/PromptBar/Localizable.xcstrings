        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Encapsulez n'importe quel chat web dans votre barre de menus, ou apportez votre clé API pour un chat natif en streaming. Les deux sont privés, les deux sont à vous." } },
        "sq" : { "stringUnit" : { "state" : "translated", "value" : "Mbështill çdo bisedë web në menubar, ose sill çelësin tënd të API për një bisedë vendase me streaming. Të dyja janë private, të dyja janë të tuat." } }
